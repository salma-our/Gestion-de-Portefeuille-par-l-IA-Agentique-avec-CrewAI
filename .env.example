# Copy to .env and fill in your key.

# LLM in litellm format. Free default: Groq (key: https://console.groq.com)
LLM_MODEL=groq/openai/gpt-oss-120b
GROQ_API_KEY=your_groq_api_key_here

# Other providers: set LLM_MODEL=mistral/mistral-small-latest and MISTRAL_API_KEY=...

PORTFOLIO_BUDGET=10000
RISK_PROFILE=moderate
